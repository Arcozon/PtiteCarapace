# export PROMPT_FORMAT='\e[1;90m\][\e[1;38;2;55;65;255m\]\M\e[1;90m\]][\e[1;36m\]\u@\h\e[1;90m\]]\n\?\[↳\]\a\s \e[1;38;2;178;102;255m\]\w \?$\e[38;5;249m\]> '
# export PROMPT_FORMAT='\e[1;34m\]\M\e[90m\][\e[1;34m\]\u\e[90m\]@\e[1;36m\]\h\e[90m\]]\n\?\[↳\]\a \w\e[1;90m\]> '
# export PROMPT_FORMAT='\e[1;90m\][\e[1;38;2;55;65;255m\]\M\e[1;90m\]][\e[1;36m\]\u@\h\e[1;90m\]]\e[0m\]\n\?\[↳\]\a \e[1;38;2;178;102;255m\]\w \?$\e[38;5;249m\]> '
export PROMPT_FORMAT='\e[1;90m\][\e[1;38;2;55;65;255m\]\M\e[1;90m\]][\e[1;36m\]\u@\h\e[1;90m\]]       \?\S\[↲\]\a\n\?\[↳\]\a\e[1;90m\][\e[1;38;2;178;102;255m\]\w\e[1;90m\]]\?$\e[38;5;249m\]> '
export PROMPT2_FORMAT='\e[1;90m\][\e[1;93m\]\o\e[1;90m\]-\e[1;93m\]\O\e[1;90m\]]{\e[1;93m\]\l\e[1;90m\]}> '
alias l='ls -la --color=tty'
alias ls='ls --color=tty'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='../../..'
alias .....='../../../..'
alias ......='../../../../..'
alias ~='cd ~'
alias -='cd -'
